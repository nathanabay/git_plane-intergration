# Port the service listens on
PORT=3100

# Database URL for Postgres (must target the gitsync database on plane-db)
DATABASE_URL=postgres://gitsync:your_generated_db_password@plane-db:5432/gitsync

# Redis URL for Valkey (must target plane-redis)
REDIS_URL=redis://plane-redis:6379

# Queue prefix for BullMQ
QUEUE_PREFIX=gitsync

# Plane base URL. Points to the internal 'api' service in docker-compose.
# Using internal networking (http://api:8000) avoids round-tripping through the external Caddy proxy.
PLANE_BASE_URL=http://api:8000

# Match SESSION_COOKIE_NAME in plane.env (default session-id).
PLANE_SESSION_COOKIE_NAME=session-id

# Plane service PAT (must belong to a dedicated service account)
PLANE_SERVICE_PAT=your_plane_service_pat

# Secret for validating webhooks from Plane
PLANE_WEBHOOK_SECRET=your_plane_webhook_secret

# Previous Plane webhook secret (optional): accept both during rotation, then remove this value.
# PLANE_WEBHOOK_SECRET_PREVIOUS=your_previous_plane_webhook_secret

# GitHub App bootstrap (optional). Set GITHUB_APP_ID, GITHUB_PRIVATE_KEY_PATH and GITHUB_WEBHOOK_SECRET together,
# or leave all three out and add the App later in God mode > Git Sync > GitHub App (stored encrypted).
GITHUB_APP_ID=your_github_app_id

# Optional parity OAuth bootstrap (Client ID is distinct from App ID).
# Set both together. Wave 2 consumes these into encrypted App settings; never expose the secret in the UI.
# GITHUB_CLIENT_ID=your_github_app_client_id
# GITHUB_CLIENT_SECRET=your_github_app_client_secret
# GITHUB_APP_SLUG=your-app-slug

# Path to the GitHub App private key file (mounted via docker-compose)
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem

# Writable persistent retirement state; kept across container recreation, separately from the PEM.
GITHUB_CREDENTIAL_MARKER_PATH=/var/lib/gitsync/credentials/bootstrap-retired

# Secret for validating webhooks from GitHub
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# Token key for encrypting stored tokens (32 random bytes, base64)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GITSYNC_TOKEN_KEY=your_base64_encoded_32_byte_key

# Requests per minute git-sync may send to Plane's API (default 60). It MUST match Plane's own API_KEY_RATE_LIMIT in
# plane.env (60/minute unless you raised it): a higher value here makes Plane answer 429, a lower one wastes headroom.
PLANE_API_RATE_PER_MINUTE=60

# Plane user id of the service account that owns PLANE_SERVICE_PAT (required). Webhook events
# whose actor is this user are recognised as our own echoes and dropped on ingress.
PLANE_SERVICE_USER_ID=your_plane_service_user_id

# Origin of the Plane site; the config API accepts state-changing requests only from it (CSRF check).
PUBLIC_ORIGIN=https://tasks.qelal.et

# GitHub edition: github | ghe_cloud | ghes. Unset means infer from the host settings below,
# or from the legacy API URL, with github as the default. One App/edition per service instance.
# GITHUB_EDITION=github

# Enterprise Cloud with data residency: a single label, e.g. octocorp (not octocorp.ghe.com).
# Derives https://api.octocorp.ghe.com and https://octocorp.ghe.com.
# GITHUB_EDITION=ghe_cloud
# GITHUB_GHE_SUBDOMAIN=octocorp

# Enterprise Server: the HTTPS web origin. Derives <origin>/api/v3 and <origin>.
# GITHUB_EDITION=ghes
# GITHUB_GHES_BASE_URL=https://ghe.example.com

# Legacy API URL remains supported and infers edition/web host when edition is unset.
# If also setting an edition/host, this must match the derived API URL exactly (trailing slash allowed).
# GITHUB_API_BASE_URL=https://ghe.example.com/api/v3
# GITHUB_API_BASE_URL=https://api.octocorp.ghe.com
# GITHUB_WEB_ORIGIN is derived output, not an environment override.

# Honour Smart Commit commands only on commits GitHub reports as signature-verified (optional; 1/true to enable).
# REQUIRE_VERIFIED_COMMITS=false
