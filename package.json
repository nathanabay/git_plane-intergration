{
  "name": "git-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Plane <-> GitHub sync service for self-hosted Plane Community Edition",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:ui": "node src/ui/build.mjs --outdir dist/ui"
  },
  "dependencies": {
    "@octokit/app": "16.1.4",
    "@octokit/webhooks": "14.2.0",
    "@octokit/webhooks-methods": "6.0.0",
    "bullmq": "6.3.12",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
